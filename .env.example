# === REQUIRED (app will not start without these) ===

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Authentication — minimum 32 characters, cryptographically random
JWT_SECRET="generate-a-secure-random-secret-here"

# Auth provider: "supabase" (all logins via Supabase Auth) or "local" (bcrypt, dev/test only).
# Production ALWAYS authenticates via Supabase Auth and will refuse to start otherwise.
# Defaults to "supabase" in production and "local" in non-production.
AUTH_PROVIDER="supabase"

# Encryption — 64 hex characters (32 bytes) for AES-256
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# === OPTIONAL ===

# Supabase Anon Key (for frontend)
SUPABASE_ANON_KEY="your-anon-key"

# Supabase Migration Scripts (only for setupSupabase.ts / fixPartnerRole.ts)
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_ACCESS_TOKEN="sbp_your-access-token"

# Server
PORT=3000

# AI (optional)
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="http://localhost:3000"

# Password for demo users (dev only)
DEMO_PASSWORD="password123"
