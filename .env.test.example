# ============================================================================
# TEST PROJECT ENV — copy to .env.test (GITIGNORED) for integration tests.
# ============================================================================
#
# The integration tests (tests/*.test.ts) run against a REAL Supabase project —
# they do NOT fake the client anymore. You must provision a dedicated TEST
# project (never the dev/prod project) and drop its URL + keys here.
#
#   npm run test:prepare   # apply migrations 001..041 to the test project
#   npm test               # unit + integration tests
#   npm run test:reset     # wipe the test project (website)
#
# WARNING: tools/prepareTestDb.ts and the reset_test_schema() RPC it enables
# TRUNCATE app tables AND delete every auth.user. Only touch a disposable test
# project with these. The app will refuse to run integration tests if these
# values point at the same project as your .env (dev) file.

# REQUIRED
SUPABASE_URL="https://your-test-project.supabase.co"
SUPABASE_SERVICE_KEY="your-test-project-service-role-key"
SUPABASE_ANON_KEY="your-test-project-anon-key"

# Auth — ANY value works here locally; it signs the JWT issued by the app after
# GoTrue verifies the email/password. Use a distinct value from dev.
JWT_SECRET="test-only-jwt-secret-please-change-me-aaaaaaaaaaaaaaaaaaaaaaaa"

# Encryption — 64 hex characters (32 bytes); must match .env if tests touch
# PII decryption.
ENCRYPTION_KEY="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Local server used by tests
PORT=3010
APP_URL="http://localhost:3010"